# =============================================================================
# Traversal policy, as annotations
# =============================================================================
# Not axioms: these say how a consumer should WALK the merged graph. A
# relation propagating `inverse` means avoidance travels object to subject,
# which is the direction RO:0001000 is asserted in. Emitted so a SPARQL
# consumer can read the policy from the data instead of re-deriving it.

obo:RO_0001000 local:propagatesAvoidance "inverse" ;
    rdfs:comment "core derivation: product derives from source organism/material" .
obo:RO_0002162 local:propagatesAvoidance "inverse" ;
    rdfs:comment "only systematic bridge from FoodOn classes into the NCBITaxon backbone; required for class-level botanical queries" .
obo:FOODON_00001563 local:propagatesAvoidance "inverse" ;
    rdfs:comment "has defining ingredient: strawberry wine -> strawberry. Direct composition" .
obo:FOODON_00002420 local:propagatesAvoidance "inverse" ;
    rdfs:comment "has ingredient: direct composition" .
obo:BFO_0000050 local:propagatesAvoidance "inverse" ;
    rdfs:comment "part_of: traverse whole -> part. Was drafted as `forward` on the reasoning that part->whole is the direction avoidance travels; that was wrong and measurably so. Forward made a soy query return lobster and its 73-node subtree via `soybean oil (flavored with extract from lobster shell) part_of lobster`. Inverse is correct: avoiding lobster should flag that oil, avoiding soy should not flag lobster" .
obo:BFO_0000051 local:propagatesAvoidance "inverse" ;
    rdfs:comment "has_part: whole -> part. Composition, but 411 of 483 have anonymous fillers and are not edge-able" .
obo:RO_0002202 local:propagatesAvoidance "inverse" ;
    rdfs:comment "develops_from: mostly PO plant-anatomy, but genuinely a derivation" .
obo:RO_0003001 local:propagatesAvoidance "inverse" ;
    rdfs:comment "produced by: food produced by an organism" .
obo:OBI_0000293 local:propagatesAvoidance "inverse" ;
    rdfs:comment "has specified input: process input becomes part of the output" .
obo:RO_0002233 local:propagatesAvoidance "inverse" ;
    rdfs:comment "has input: bean flour -> bean (dried). Derivation-like" .
obo:RO_0009001 local:propagatesAvoidance "inverse" ;
    rdfs:comment "has substance added: lasagne -> cheese food product. Direct composition" .
obo:RO_0002473 local:propagatesAvoidance "inverse" ;
    rdfs:comment "composed primarily of: brown sugar -> sucrose. Targets are ChEBI, so gated by the label-granularity boundary" .
obo:RO_0002160 local:propagatesAvoidance "inverse" ;
    rdfs:comment "only_in_taxon: taxon restriction, same role as in taxon" .
obo:RO_0009003 local:propagatesAvoidance "inverse" ;
    rdfs:comment "immersed in: 1 edge (lasagne -> packed in gravy or sauce). Kept for recall, low confidence" .
obo:RO_0002350 local:propagatesAvoidance "none" ;
    rdfs:comment "member of: 2,343 edges pointing almost entirely at US CFR regulatory groupings. A classification facet, not composition -- propagating it would link every nutritive sweetener to every other. Retained as the primary input to the section 6 functional rollup" .
obo:RO_0000086 local:propagatesAvoidance "none" ;
    rdfs:comment "has quality: quality annotation, not composition" .
obo:RO_0002351 local:propagatesAvoidance "none" ;
    rdfs:comment "has member: inverse of member of, same reasoning" .
obo:RO_0001025 local:propagatesAvoidance "none" ;
    rdfs:comment "located_in: geography (GAZ)" .
obo:RO_0002353 local:propagatesAvoidance "none" ;
    rdfs:comment "output of: points at a process (food (canned) -> food canning), not an ingredient" .
obo:OBI_0000312 local:propagatesAvoidance "none" ;
    rdfs:comment "is specified output of: points at a process" .
obo:FOODON_00001301 local:propagatesAvoidance "none" ;
    rdfs:comment "has food substance analog: imitation peanut butter -> peanut butter. MUST NOT propagate -- an analog is defined by NOT containing the thing it imitates. Surfaced in the UI as 'related, verify separately', never as containment" .
obo:OBI_0000299 local:propagatesAvoidance "none" ;
    rdfs:comment "has specified output: process output, wrong direction for containment" .
obo:HANCESTRO_0308 local:propagatesAvoidance "none" ;
    rdfs:comment "hasCountryOfOrigin: geography" .
obo:RO_0009004 local:propagatesAvoidance "none" ;
    rdfs:comment "has consumer: who eats it, not what is in it" .
obo:RO_0000053 local:propagatesAvoidance "none" ;
    rdfs:comment "has characteristic: quality annotation" .
obo:RO_0000056 local:propagatesAvoidance "none" ;
    rdfs:comment "participates_in: process participation" .
obo:IAO_0000136 local:propagatesAvoidance "none" ;
    rdfs:comment "is about: metadata" .
obo:RO_0002219 local:propagatesAvoidance "none" ;
    rdfs:comment "surrounded by: spatial, not compositional" .
obo:RO_0000057 local:propagatesAvoidance "none" ;
    rdfs:comment "has_participant: process participation" .
obo:RO_0002170 local:propagatesAvoidance "none" ;
    rdfs:comment "connected to: spatial" .
obo:RO_0002234 local:propagatesAvoidance "none" ;
    rdfs:comment "has output: process output" .
obo:BFO_0000062 local:propagatesAvoidance "none" ;
    rdfs:comment "preceded_by: temporal" .

### excluded branch: agency food product type  (6074 classes)
#   parallel regulatory classification vocabularies (EFSA FoodEx2, US CFR, EC,
#   CCPR). '00030 - cereal grains' alone groups wheat, maize, rye, barley and
#   rice, so traversing this branch leaks corn into wheat without ever
#   ascending the food hierarchy. See audit F10.
obo:FOODON_03400361 local:excludedFromTraversal true .
### excluded branch: embryo  (12 classes)
#   UBERON developmental stages -- morula, blastula, gastrula, neurula,
#   2/4/8-cell stage. FoodOn parents `embryo` under `animal egg`, which is
#   defensible biologically: an egg does contain one. But these are stages of
#   development, not things that appear on a plate or a label, and they are
#   the only non-food members of the animal egg subtree. Excluded when `animal
#   egg` was added as a root for the `egg` query, so that adding quail, goose
#   and ostrich egg did not also add 12 embryology classes. Whole branch is
#   UBERON and 12 classes; no food class sits under it.
obo:UBERON_0000922 local:excludedFromTraversal true .

# --- parallel-hierarchy correspondences -------------------------------------
# The same organism under two FoodOn class trees that share no terms.
# Emitted because a closure that starts on only one of the pair silently
# under-reports: measured on Solanaceae, 620 classes from NCBITaxon_4070
# alone against 630 with the pair. Computed per root by taxon pivot or label
# convention, not listed by hand.

