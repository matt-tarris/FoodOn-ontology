# =============================================================================
# Exceptions that OWL cannot express as retractions   (2)
# =============================================================================
# OWL is monotonic: an import adds and never removes. Where an upstream
# axiom is ontologically defensible but wrong for avoidance, the exception
# is stated declaratively for a traversal to honour.


### milk  --notAvoidanceRelevantFor-->  bovine meat food product
#   confidence: high
#   claim:      not_avoidance_relevant
#   query:      bovine meat food product
#   reviewer:   Matt
#   `bovine meat food product is_a cow food product`, and `cow food product`
#   carries `in taxon Bos taurus`. The species pivot then walks back down from
#   the taxon and reaches everything else bovine, including `cow milk`,
#   `cheddar cheese` and 675 more dairy classes -- so a BEEF query told a
#   diner to avoid milk. Beef and milk are separate avoidances: FALCPA lists
#   milk as an allergen and beef not at all, and someone who avoids beef for
#   religious or dietary reasons is usually not avoiding dairy. Suppressing
#   `milk` for this root takes the closure from 1,555 to 785 and dairy from
#   677 to 25, while keeping beef steak, ground beef patty, beef jerky, beef
#   broth and beef liver.
obo:UBERON_0001913 local:notAvoidanceRelevantFor obo:FOODON_00001134 .
local:patch-e0d6f777300f a local:Patch ;
    local:patchSection "remove" ;
    local:patchTarget obo:UBERON_0001913 ;
    local:patchProperty local:notAvoidanceRelevantFor ;
    local:patchValue obo:FOODON_00001134 ;
    local:patchConfidence "high" ;
    local:patchClaim "not_avoidance_relevant" ;
    local:patchQuery "bovine meat food product" ;
    rdfs:comment "`bovine meat food product is_a cow food product`, and `cow food product` carries `in taxon Bos taurus`. The species pivot then walks back down from the taxon and reaches everything else bovine, including `cow milk`, `cheddar cheese` and 675 more dairy classes -- so a BEEF query told a diner to avoid milk. Beef and milk are separate avoidances: FALCPA lists milk as an allergen and beef not at all, and someone who avoids beef for religious or dietary reasons is usually not avoiding dairy. Suppressing `milk` for this root takes the closure from 1,555 to 785 and dairy from 677 to 25, while keeping beef steak, ground beef patty, beef jerky, beef broth and beef liver." ;
    dcterms:creator "Matt" ;
    dcterms:created "2026-09-10"^^xsd:date .

### peanut plant  --notAvoidanceRelevantFor-->  nut producing plant
#   confidence: high
#   claim:      not_avoidance_relevant
#   query:      nut producing plant
#   reviewer:   Matt
#   FoodOn asserts `peanut plant is_a nut producing plant`, defensible
#   botanically but wrong for allergens: FALCPA treats peanut and tree nut as
#   SEPARATE allergens. Without this a tree-nut query returns peanut and its
#   91-node closure. The two FoodOn sub-branches that exclude peanut cover
#   only 4 of 7 major tree nuts between them, so there is no clean class to
#   resolve to instead. Confirmed by Matt 2026-09-09: disconnect in both
#   directions.
obo:FOODON_03411337 local:notAvoidanceRelevantFor obo:FOODON_03411213 .
local:patch-225d55b2b91c a local:Patch ;
    local:patchSection "remove" ;
    local:patchTarget obo:FOODON_03411337 ;
    local:patchProperty local:notAvoidanceRelevantFor ;
    local:patchValue obo:FOODON_03411213 ;
    local:patchConfidence "high" ;
    local:patchClaim "not_avoidance_relevant" ;
    local:patchQuery "nut producing plant" ;
    rdfs:comment "FoodOn asserts `peanut plant is_a nut producing plant`, defensible botanically but wrong for allergens: FALCPA treats peanut and tree nut as SEPARATE allergens. Without this a tree-nut query returns peanut and its 91-node closure. The two FoodOn sub-branches that exclude peanut cover only 4 of 7 major tree nuts between them, so there is no clean class to resolve to instead. Confirmed by Matt 2026-09-09: disconnect in both directions." ;
    dcterms:creator "Matt" ;
    dcterms:created "2026-09-10"^^xsd:date .


# =============================================================================
# Retired patches, kept for the audit trail   (1)
# =============================================================================
# These were correct and signed, and are now carried by structure instead --
# either upstream or by another patch. No axiom is emitted. They are listed
# so that the record of why the gap existed survives, and so a regression is
# recognisable.


### tahini  --RO:0001000-->  sesame plant
#   by:         mined bridge `tahini -> sesame plant`, signed in config/mined-signoff.json
#   reviewer:   Matt
#   FoodOn's own definition of tahini reads 'a condiment made from toasted
#   ground hulled sesame'. build/classify_mined.py extracted that, it was
#   signed, and the class is now reached structurally, so this override no
#   longer has work to do. Retired rather than deleted: the record of WHY the
#   gap existed is the useful part, and if the structural route ever breaks,
#   test/override_run.py fails and names this entry as the fix.
#   (no axiom emitted)
local:patch-6b7a0e85c496 a local:Patch ;
    local:patchSection "superseded" ;
    local:patchTarget obo:FOODON_00003855 ;
    local:patchProperty obo:RO_0001000 ;
    local:patchValue obo:FOODON_03411226 ;
    local:supersededBy "mined bridge `tahini -> sesame plant`, signed in config/mined-signoff.json" ;
    rdfs:comment "FoodOn's own definition of tahini reads 'a condiment made from toasted ground hulled sesame'. build/classify_mined.py extracted that, it was signed, and the class is now reached structurally, so this override no longer has work to do. Retired rather than deleted: the record of WHY the gap existed is the useful part, and if the structural route ever breaks, test/override_run.py fails and names this entry as the fix." ;
    dcterms:creator "Matt" ;
    dcterms:created "2026-09-10"^^xsd:date .


