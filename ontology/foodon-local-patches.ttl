    local:patchConfidence "high" ;
    local:patchClaim "may_contain" ;
    local:patchQuery "wheat plant" ;
    rdfs:comment "Soy sauce is brewed from soybeans AND wheat in roughly equal parts in the dominant Japanese and Chinese styles, yet FoodOn asserts no wheat derivation, so the class sits outside the gluten closure entirely. The identity is a soy product; the wheat is a producer choice, which is what may_contain is for. This class also covers `soy sauce (proteolytic fermentation)` and `soy sauce (acid-hydrolyzed)`." ;
    dcterms:creator "Matt" ;
    dcterms:created "2026-09-10"^^xsd:date .

